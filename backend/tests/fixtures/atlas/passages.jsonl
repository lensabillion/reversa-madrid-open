{"actor_id": "actor:tr:123456789012-34", "document_id": "doc:hys_feedback:9000001", "language": "en", "passage_id": "passage:makers-1", "procedure_id": "2099/0001(COD)", "schema_version": "atlas-1", "span": {"end": 160, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000001", "start": 44, "text": "In Article 5(1), providers shall keep technical logs for at least six months after placing the widget on the market."}, "submitted_at": "2099-02-01T12:00:00Z"}
{"actor_id": "actor:tr:234567890123-45", "document_id": "doc:hys_feedback:9000002", "language": "en", "passage_id": "passage:watch-1", "procedure_id": "2099/0001(COD)", "schema_version": "atlas-1", "span": {"end": 156, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000002", "start": 48, "text": "Providers should not be required to keep technical logs for any fixed period, because logs expose user data."}, "submitted_at": "2099-02-03T12:00:00Z"}
{"actor_id": "actor:tr:345678901234-56", "document_id": "doc:hys_attachment:fixture0003", "language": "en", "passage_id": "passage:city-1", "procedure_id": "2099/0001(COD)", "schema_version": "atlas-1", "span": {"end": 162, "field": "text", "page": null, "record_id": "doc:hys_attachment:fixture0003", "start": 31, "text": "In Article 9(2), replace 'shall' with 'may': the authority may publish the assessment where publication serves the public interest."}, "submitted_at": "2099-02-05T12:00:00Z"}
{"actor_id": "actor:name:hys_feedback.acme", "document_id": "doc:hys_feedback:9000004", "language": "en", "passage_id": "passage:acme-1", "procedure_id": "2099/0001(COD)", "schema_version": "atlas-1", "span": {"end": 104, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000004", "start": 35, "text": "Small providers need at least twelve months before Article 5 applies."}, "submitted_at": "2099-02-07T12:00:00Z"}
{"actor_id": "actor:tr:123456789012-34", "document_id": "doc:hys_attachment:fixture0005", "language": "en", "passage_id": "passage:undated-1", "procedure_id": "2099/0001(COD)", "schema_version": "atlas-1", "span": {"end": 99, "field": "text", "page": null, "record_id": "doc:hys_attachment:fixture0005", "start": 0, "text": "Providers shall keep technical logs for at least six months after placing the widget on the market."}, "submitted_at": null}
{"actor_id": "actor:name:hys_attachment.label-alliance", "document_id": "doc:hys_feedback:9000006", "language": "en", "passage_id": "passage:labels-1", "procedure_id": "2099/0002(COD)", "schema_version": "atlas-1", "span": {"end": 117, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000006", "start": 0, "text": "Label Alliance asks that Article 3 require the energy grade to be printed in a font no smaller than the product name."}, "submitted_at": "2099-07-01T12:00:00Z"}
