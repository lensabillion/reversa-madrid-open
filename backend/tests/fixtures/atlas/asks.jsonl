{"actor_id": "actor:name:hys_attachment.label-alliance", "ask_id": "ask:b-labels", "direction": "stricter", "document_id": "doc:hys_feedback:9000006", "extraction_method": "fixture", "joint_actor_ids": [], "language": "en", "passage_id": "passage:labels-1", "procedure_id": "2099/0002(COD)", "requested_change": "Print the energy grade as large as the product name", "schema_version": "atlas-1", "span": {"end": 117, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000006", "start": 0, "text": "Label Alliance asks that Article 3 require the energy grade to be printed in a font no smaller than the product name."}, "submitted_at": "2099-07-01T12:00:00Z", "target_provision": "Article 3"}
