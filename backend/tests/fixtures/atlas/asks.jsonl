{"actor_id": "actor:tr:123456789012-34", "ask_id": "ask:a-makers", "direction": "stricter", "document_id": "doc:hys_feedback:9000001", "extraction_method": "fixture", "joint_actor_ids": [], "language": "en", "passage_id": "passage:makers-1", "procedure_id": "2099/0001(COD)", "requested_change": "Keep logs for at least six months", "schema_version": "atlas-1", "span": {"end": 160, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000001", "start": 44, "text": "In Article 5(1), providers shall keep technical logs for at least six months after placing the widget on the market."}, "submitted_at": "2099-02-01T12:00:00Z", "target_provision": "Article 5(1)"}
{"actor_id": "actor:tr:234567890123-45", "ask_id": "ask:a-watch", "direction": "weaker", "document_id": "doc:hys_feedback:9000002", "extraction_method": "fixture", "joint_actor_ids": [], "language": "en", "passage_id": "passage:watch-1", "procedure_id": "2099/0001(COD)", "requested_change": "No fixed period for keeping logs", "schema_version": "atlas-1", "span": {"end": 156, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000002", "start": 48, "text": "Providers should not be required to keep technical logs for any fixed period, because logs expose user data."}, "submitted_at": "2099-02-03T12:00:00Z", "target_provision": "Article 5(1)"}
{"actor_id": "actor:tr:345678901234-56", "ask_id": "ask:a-city", "direction": "weaker", "document_id": "doc:hys_attachment:fixture0003", "extraction_method": "fixture", "joint_actor_ids": [], "language": "en", "passage_id": "passage:city-1", "procedure_id": "2099/0001(COD)", "requested_change": "Replace shall with may", "schema_version": "atlas-1", "span": {"end": 162, "field": "text", "page": null, "record_id": "doc:hys_attachment:fixture0003", "start": 31, "text": "In Article 9(2), replace 'shall' with 'may': the authority may publish the assessment where publication serves the public interest."}, "submitted_at": "2099-02-05T12:00:00Z", "target_provision": "Article 9(2)"}
{"actor_id": "actor:name:hys_feedback.acme", "ask_id": "ask:a-acme", "direction": "delay", "document_id": "doc:hys_feedback:9000004", "extraction_method": "fixture", "joint_actor_ids": [], "language": "en", "passage_id": "passage:acme-1", "procedure_id": "2099/0001(COD)", "requested_change": "Twelve-month transition for small providers", "schema_version": "atlas-1", "span": {"end": 104, "field": "text", "page": null, "record_id": "doc:hys_feedback:9000004", "start": 35, "text": "Small providers need at least twelve months before Article 5 applies."}, "submitted_at": "2099-02-07T12:00:00Z", "target_provision": "Article 5"}
