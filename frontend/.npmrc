# Applies to every npm command run in frontend/. See SUPPLY-CHAIN-SECURITY.md.

# Install scripts are how a malicious package version runs code during `npm install`.
ignore-scripts=true
# Resolve only versions published more than 14 days ago (npm 11.10 and later).
min-release-age=14
save-exact=true
# Refuse, instead of warning, when Node.js does not satisfy an "engines" range.
engine-strict=true
